export interface Anime {
  id: string;
  title: string;
  description: string;
  coverImage: string;
  bannerImage: string;
  rating: number;
  year: number;
  episodes: Episode[];
  type: 'Series' | 'Movie';
  genres: string[];
  language: string[];
  trending?: boolean;
  views: number;
}

export interface Episode {
  id: string;
  number: number;
  title: string;
  videoUrl: string;
  thumbnail: string;
}
